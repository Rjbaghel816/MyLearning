									"language": "json"
								}
							}
						},
						"url": {
							"raw": "{{url}}/api/auth/signup",
							"host": [
								"{{url}}"
							],
							"path": [
								"api",
								"auth",
								"signup"
							]
						}
					},
					"response": []
				}
